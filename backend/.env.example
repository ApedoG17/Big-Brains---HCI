# PepperDem Backend — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000

# JWT — generate a strong random secret for production
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Paystack — get your keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Frontend URL for CORS (no trailing slash)
FRONTEND_URL=http://localhost:5173

# SQLite database file path (relative to backend/)
DB_PATH=./db/pepperdem.db
